{
  "name": "netops-agent-standalone",
  "version": "1.0.0",
  "description": "NetOps PC Agent - Standalone Version for LAN/USB tethering",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:exe": "pkg . --targets node18-win-x64 --output NetOpsAgent.exe --no-bytecode --public --public-packages \"*\""
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0"
  },
  "pkg": {
    "assets": [],
    "scripts": [],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "."
  }
}
